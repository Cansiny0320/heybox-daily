{
  "name": "heybox-daily",
  "version": "0.4.2",
  "private": true,
  "description": "小黑盒每日签到和分享任务",
  "type": "module",
  "exports": {
    "./*": "./dist/*.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm build && tsc -p tsconfig.test.json",
    "check": "pnpm build && node dist/cli.js check",
    "start": "pnpm build && node dist/cli.js run",
    "test": "pnpm typecheck && node --test test/*.test.ts"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@types/jsdom": "27.0.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "fingerprint-generator": "2.1.89",
    "jsdom": "27.0.1"
  }
}
