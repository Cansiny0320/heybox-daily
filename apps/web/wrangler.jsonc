{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heybox-daily",
  "account_id": "b844e50c43f36e313952cf13a4dafca7",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal", "request_signal_passthrough"],
  "workers_dev": false,
  "assets": { "html_handling": "none" },
  "kv_namespaces": [{ "binding": "SITE_CONFIG", "id": "05d04cf561004bd9b5b6084deb9dedf4" }],
  "r2_buckets": [{ "binding": "SPONSOR_ASSETS", "bucket_name": "heybox-daily-assets" }],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "routes": [{ "pattern": "heybox.cansiny.top", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heybox-daily",
      "database_id": "b70ffb01-5c23-4971-9b48-0ad92f47e6f6",
      "migrations_dir": "migrations",
    },
  ],
  "triggers": { "crons": ["30 * * * *"] },
  "services": [{ "binding": "EXECUTOR", "service": "heybox-executor" }],
  "vars": {
    "SITE_URL": "https://heybox.cansiny.top",
    "RUNNER_URL": "https://heybox-runner.cansiny.top",
    "EXECUTOR_ENABLED": "true",
    "DAILY_EXECUTOR": "cloudflare",
  },
  "env": {
    "staging": {
      "name": "heybox-daily-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "preview.heybox.cansiny.top", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "heybox-daily-staging",
          "database_id": "4330a4a2-af40-41df-9048-aa2db3c45df0",
          "migrations_dir": "migrations",
        },
      ],
      "triggers": { "crons": [] },
      "services": [],
      "kv_namespaces": [],
      "r2_buckets": [],
      "vars": {
        "DEPLOYMENT_ENV": "staging",
        "SITE_URL": "https://preview.heybox.cansiny.top",
        "RUNNER_URL": "https://heybox-preview-runner.cansiny.top",
      },
    },
  },
}
